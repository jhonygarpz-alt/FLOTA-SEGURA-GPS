# ================================================================
# FLOTA SEGURA GPS — variables de entorno (EJEMPLO, sin valores reales)
# Nunca suba el archivo .env a GitHub.
# Genere secretos con:  openssl rand -base64 48
# ================================================================

# --- API (servicio "api" en Railway) ---
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/BASE?schema=public
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=14
# Saltos de proxy confiables: borde de Railway + nginx del servicio web
TRUST_PROXY_HOPS=2
AUTH_RATE_LIMIT=10
DEMO_ENABLED=true
DEVICE_OFFLINE_MINUTES=10

# Superadministrador inicial (solo para el seed; puede eliminarse después)
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

# --- Conexión con Traccar (VPS) ---
TRACCAR_URL=https://traccar.su-dominio.com
TRACCAR_ADMIN_EMAIL=
TRACCAR_ADMIN_PASSWORD=
TRACCAR_PROXY_SECRET=
# IP pública o dominio que se programa en los equipos GPS
TRACCAR_PUBLIC_HOST=gps.su-dominio.com

# --- Web (servicio "web" en Railway) ---
# URL del backend al que nginx reenvía /api (incluya https://)
API_UPSTREAM=https://api-xxxx.up.railway.app
PORT=8080
# Opcionales (tiempo de compilación)
VITE_MAP_STYLE_URL=
VITE_MAP_STYLE_DARK_URL=
VITE_SATELLITE_STYLE_URL=

# --- Docker Compose local ---
POSTGRES_PASSWORD=
TRACCAR_DB_PASSWORD=
